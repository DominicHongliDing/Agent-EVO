# 配置参考：应用读取进程环境，不会自动加载此文件。详见 docs/local-setup.md。
EVO_DB_PATH=./.local/evo.db
EVO_ARTIFACT_ROOT=./.local/artifacts
EVO_UNIHR_BASE_URL=http://127.0.0.1:8088
EVO_CLINICAL_BASE_URL=http://127.0.0.1:8000
EVO_UNIHR_SOURCE_ROOT=./external/unihr-server
EVO_CLINICAL_SOURCE_ROOT=./external/clinical-agent
EVO_UNIHR_USERNAME=
EVO_UNIHR_PASSWORD=
EVO_UNIHR_USAGE_DB_PATH=
EVO_CLINICAL_USER_ID=evo_synthetic_user
EVO_CLINICAL_ACCESS_TOKEN=
EVO_RUN_TIMEOUT_SECONDS=600
# 需要共享访问时配置反向代理和此 token；本机单用户可留空。
EVO_ACCESS_TOKEN=
# 多轮独立语义评审：业务调用数与评审用量分别记录；模型结论待人工复核。
EVO_CONTEXT_JUDGE_ENABLED=1
EVO_CONTEXT_JUDGE_MODEL=qwen3.6-flash
EVO_CONTEXT_JUDGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 如已在进程环境配置，不要复制原项目 .env；这里只列变量名。
DASHSCOPE_API_KEY=
# 原生后端桥接：配置在 UniHR/Clinical 的进程环境，密钥仅留服务端
EVO_PLATFORM_URL=http://127.0.0.1:8090
EVO_PLATFORM_PUBLIC_URL=http://127.0.0.1:8090
EVO_RECORDING_TOKEN=
# 仅设置在原 Clinical 的合成评测进程；普通聊天默认不采集。
EVO_CAPTURE_EVIDENCE=0
# 可选 Compose 覆盖文件需要指定原项目的证据目录，非凭证目录。
EVO_CLINICAL_EVIDENCE_DIR=./external/clinical-agent/.local/evo-evidence

# Langfuse: 项目级凭证仅在本地执行器/线上 BFF 进程设置，不进入前端。
EVO_LOCAL_SCRIPTS_ENABLED=1
EVO_LANGFUSE_SYNC_ENABLED=1
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROJECT_ID=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# 独立的私有线上结果服务；本地执行器不需要这组配置。
EVO_RESULTS_PUBLIC_URL=
EVO_GITHUB_CLIENT_ID=
EVO_GITHUB_CLIENT_SECRET=
EVO_GITHUB_OWNER_ID=
EVO_SESSION_SECRET=

# Independent report writer; quota stop must also be enabled in Bailian console.
EVO_REPORT_MODEL=qwen3.8-max-0902
